{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {jsx, "3.1.0"},
    {telemetry, "1.3.0"}
]}.

{profiles, [
    {test, [
        {deps, [
            {cowboy, "2.12.0"},
            {covertool, "2.0.6"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all]},
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {cover_export_enabled, true},
        {cover_spec, "cover.spec"},
        {covertool, [{coverdata_files, ["eunit.coverdata", "ct.coverdata"]}]}
    ]}
]}.

{ct_opts, [{dir, "test"}]}.

{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unmatched_returns
    ]},
    %% jsx and telemetry are optional deps
    {plt_extra_apps, [jsx, telemetry]}
]}.

{shell, [{apps, [erl_openrouter]}]}.
