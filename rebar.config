{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {cowboy, "2.12.0"},
    {jsx, "3.1.0"}
]}.

{profiles, [
    {test, [
        {deps, [
            {cowboy, "2.12.0"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all]}
    ]},
    {streaming, [
        {deps, [
            {gun, "2.1.0"}
        ]}
    ]}
]}.

{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc
]}.

{shell, [{apps, [erl_openrouter]}]}.
