{application, erl_openrouter, [
    {description, "Erlang client for the OpenRouter API"},
    {vsn, "0.1.1"},
    {registered, [openrouter_sup, openrouter_client,
                  openrouter_rate_limiter, openrouter_circuit_breaker,
                  openrouter_usage]},
    {mod, {openrouter_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        crypto
    ]},
    {optional_applications, [jsx, telemetry]},
    {env, [
        {base_url, "https://openrouter.ai/api/v1"},
        {timeout, 30000}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
